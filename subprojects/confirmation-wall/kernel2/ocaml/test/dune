; speed tests (tests/speed-local.sh: their limits hold on this desktop only) locally;
; tests/engine-proofs.sh holds the X3/X2/C1/C2 axiom listing.

(alias
 (name step3-fast-readings)
 (deps
  (alias runtest)))

(rule
 (alias runtest)
 (deps
  scripts/orders-crossings.sh
  fixtures/orders-crossings.lean
  fixtures/orders.lean
  fixtures/x4-specials.lean
  %{env:MM2_ENGINE_LIB=missing-engine-archive})
 (action
  (progn
   (run sh scripts/orders-crossings.sh fixtures/orders-crossings.lean)
   (run sh scripts/orders-crossings.sh fixtures/orders.lean)
   (run sh scripts/orders-crossings.sh fixtures/x4-specials.lean))))

(alias
 (name step5-orders)
 (deps
  (alias runtest)))

