   "auth": {
    "param": "UserID",
    "env": "BEA_API_KEY"
   }
  },
  {
   "name": "bea-personal-income",
   "source": "bea",
   "every_h": 24,
   "url": "https://apps.bea.gov/api/data?method=GetData&DataSetName=NIPA&TableName=T20600&Frequency=M&Year=X&ResultFormat=JSON",
   "auth": {
    "param": "UserID",
    "env": "BEA_API_KEY"
   }
  },
  {
   "name": "eia-natural-gas-storage",
   "source": "eia",
   "every_h": 24,
   "url": "https://api.eia.gov/v2/natural-gas/stor/wkly/data/?frequency=weekly&data[0]=value&sort[0][column]=period&sort[0][direction]=desc&length=100",
   "auth": {
    "param": "api_key",
    "env": "EIA_API_KEY"
   }
  },
  {
   "name": "sec-xbrl-filings",
   "source": "sec",
   "every_h": 1,
   "url": "https://www.sec.gov/Archives/edgar/xbrlrss.all.xml",
